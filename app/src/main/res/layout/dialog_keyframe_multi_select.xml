<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#2A2A3F"
    android:padding="12dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="选择关键帧"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvMultiSelectCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="已选择 0 个"
            android:textColor="#4CAF50"
            android:textSize="11sp"
            android:layout_marginEnd="6dp"/>
    </LinearLayout>

    <!-- 操作按钮栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnMultiSelectCancel"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="取消"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="6dp"
            style="@style/Widget.Material3.Button.OutlinedButton"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"/>

        <Button
            android:id="@+id/btnMultiSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="全选"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="6dp"
            style="@style/Widget.Material3.Button.TonalButton"/>

        <Button
            android:id="@+id/btnMultiSelectDelete"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="删除选中"
            android:textSize="11sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            style="@style/Widget.Material3.Button.TonalButton"/>
    </LinearLayout>

    <!-- 关键帧列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/keyframeListRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:background="#1E1E28"/>
</LinearLayout>
